# Assistant provider: use rag_api for the local RAG backend, llm_api for direct LLM calls, or mock for demo data.
VITE_ASSISTANT_PROVIDER=rag_api

# Local FastAPI RAG backend endpoint. The browser calls this endpoint only; API keys stay server-side.
VITE_RAG_API_URL=http://127.0.0.1:8000/api/chat

# Processing backend endpoint. It generates task configs only until a Linux worker is added.
VITE_PROCESSING_API_BASE_URL=http://127.0.0.1:8000/api/processing

# OpenAI-compatible chat completions endpoint.
# Example base URL format only. Fill this yourself.
VITE_LLM_API_BASE_URL=
VITE_LLM_API_PATH=/v1/chat/completions

# Fill your own model name and API key.
# For a local proxy that injects credentials server-side, leave VITE_LLM_API_KEY empty.
VITE_LLM_MODEL=
VITE_LLM_API_KEY=

# Optional generation settings.
VITE_LLM_TEMPERATURE=0.2

# Server-side or local script embedding configuration.
# Do not expose embedding keys with VITE_ unless you intentionally call APIs from the browser.
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=

# Server-side DeepSeek chat configuration for the RAG backend.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_PATH=/v1/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1200

# Optional RAG backend tuning.
RAG_TOP_K=6
RAG_LEXICAL_WEIGHT=0.2
RAG_MAX_CONTEXT_CHARS=9000

# Optional processing-code RAG index. Code evidence is auxiliary; manual evidence remains authoritative.
CODE_RAG_CHUNKS_JSONL=knowledge/code/processing/processing_code_v2_0_2.chunks.jsonl
CODE_RAG_INDEX_DIR=knowledge/code/index
CODE_RAG_DOCUMENT_SLUG=processing_code_v2_0_2
CODE_RAG_TOP_K=4

# App-owned task draft directory. Do not point this at a raw-data or result directory.
PROCESSING_TASKS_DIR=runtime/processing_tasks
